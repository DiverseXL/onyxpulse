# From https://dashboard.privy.io → your app → Settings
PRIVY_APP_ID=your_privy_app_id_here
# From https://dashboard.privy.io → your app → Settings → App management → App secret
PRIVY_APP_SECRET=your_privy_app_secret_here

# From https://dashboard.pimlico.io → your API keys
PIMLICO_API_KEY=your_pimlico_api_key_here

# OPTIONAL: reuse an existing Privy server wallet across runs (else a new one is created each run)
# PRIVY_WALLET_ID=

# OPTIONAL: force a specific DreamDEX binary pool address; if empty the script discovers one via the SDK indexer
# DREAMDEX_POOL=
