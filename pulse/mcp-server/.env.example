# Pulse MCP server — environment variables.
# Copy to .env and fill in (or set in your host's dashboard).

# Port to listen on. Railway/Render inject PORT automatically.
# PORT=4000

# Public origin of the Pulse WEB app. draft_trade_link URLs point here,
# e.g. https://pulse.example.com
PULSE_APP_URL=http://localhost:3000

# Public origin of THIS MCP server, shown to clients on /connect.
# Defaults to the request's Host header when unset — set it explicitly
# behind a proxy if clients report an internal host.
# PULSE_MCP_PUBLIC_URL=https://pulse-mcp.example.com

# ── Token auth ────────────────────────────────────────────────────────────────
# REQUIRED when deploying to Vercel (serverless). Serverless instances share
# no memory, so tokens must be stateless HMAC-signed with this secret for any
# instance to verify tokens issued by any other instance.
# Generate with: openssl rand -hex 32
# When unset (long-running single-instance hosts only), an in-memory token
# store is used instead.
# PULSE_MCP_SIGNING_SECRET=

# Lifetime of issued tokens in ms (default 30 days).
# PULSE_MCP_TOKEN_TTL_MS=2592000000

# 1 = serverless-friendly mode: no sessions, JSON responses per request.
# (Forced on Vercel regardless.)
# PULSE_MCP_STATELESS=1

# In-memory session idle timeout before the sweeper closes a session
# (long-running hosts only).
# PULSE_MCP_SESSION_IDLE_TTL_MS=1800000
