{
  "name": "pulse-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted, remote MCP server for Pulse (DreamDEX on Somnia Shannon testnet). Read-only + draft-only tools — never holds a private key and never executes a trade. Streamable HTTP transport.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "railway-start": "tsx src/railway.ts",
    "dev": "tsx watch src/railway.ts",
    "serve:vercel": "tsx scripts/serve-vercel-mode.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@somnia-chain/markets-sdk": "0.28.1",
    "tsx": "^4.23.13",
    "viem": "2.55.19",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.9.0"
  }
}
