# Get these from https://thirdweb.com/dashboard/settings/api-keys
# A free/test API key is fine. Secret key is required for server-side use of
# the AA bundler/paymaster (gas sponsorship) per thirdweb docs.
THIRDWEB_CLIENT_ID=your_client_id_here
THIRDWEB_SECRET_KEY=

# Optional fallback ONLY IF guest login fails:
PRIVATE_KEY=
