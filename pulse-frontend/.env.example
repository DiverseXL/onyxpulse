# ─────────────────────────────────────────────
# Pulse Frontend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# The app boots without these variables for read-only browsing
# (landing page, market listing, price charts).  They are only
# required for wallet-based features that go through Thirdweb
# smart accounts (gasless transactions, account abstraction).
#
# ── Thirdweb ──────────────────────────────────
# Client ID for the Thirdweb SDK (public, safe to expose in the browser).
# Get one at https://thirdweb.com/dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Secret key for the Thirdweb SDK (server-side only, never exposed to the client).
# Get one at https://thirdweb.com/dashboard
THIRDWEB_SECRET_KEY=

# ── MCP server ────────────────────────────────
# Base URL of the deployed Pulse MCP server used by /connect-agent.
# Defaults to the live deployment if unset.
NEXT_PUBLIC_MCP_URL=
